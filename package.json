{
  "name": "bonis-oculis",
  "version": "0.1.0",
  "description": "bonis oculis — scans movies once, writes a skip file, and lets any player obey it. Offline, for families.",
  "main": "desktop/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"shared/test/**/*.test.js\" \"desktop/test/**/*.test.js\" \"player/test/**/*.test.js\"",
    "test:shared": "node --test \"shared/test/**/*.test.js\"",
    "test:player": "node --test \"player/test/**/*.test.js\"",
    "test:desktop": "node --test \"desktop/test/**/*.test.js\"",
    "lint": "node tools/lint-es5.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^38.2.1"
  }
}
