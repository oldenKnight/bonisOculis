{
 "file": "dialogo.es.srt",
 "lexicon": "es",
 "seconds": 52,
 "cues": [
  {
   "start": 1.0,
   "end": 3.0,
   "text": "¿Qué onda, güey? ¿Cómo estás?"
  },
  {
   "start": 4.0,
   "end": 6.5,
   "text": "(gemidos)"
  },
  {
   "start": 7.0,
   "end": 9.0,
   "text": "(JADEOS)"
  },
  {
   "start": 12.0,
   "end": 14.0,
   "text": "¡Bésame ya!"
  },
  {
   "start": 15.0,
   "end": 17.0,
   "text": "(se besan)"
  },
  {
   "start": 20.0,
   "end": 22.0,
   "text": "(disparos)"
  },
  {
   "start": 22.5,
   "end": 25.0,
   "text": "¡Está sangrando! Hay sangre por todos lados."
  },
  {
   "start": 30.0,
   "end": 32.0,
   "text": "No seas pendejo, cabrón."
  },
  {
   "start": 35.0,
   "end": 37.0,
   "text": "Estaba desnuda en la playa."
  },
  {
   "start": 40.0,
   "end": 42.0,
   "text": "♪ Dame un beso, mi amor ♪"
  },
  {
   "start": 45.0,
   "end": 47.0,
   "text": "Pinche tráfico, ¡qué coraje!"
  },
  {
   "start": 50.0,
   "end": 52.0,
   "text": "Las bestias besan el suelo... no, la bestia descansa."
  }
 ],
